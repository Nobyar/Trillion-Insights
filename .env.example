# DudeDiligence gamma needs a signed-in account. Set both of these and the
# server signs in by itself. The sign-in form labels the first field Username.
# Put that value in DUDEDILIGENCE_EMAIL (use the account email when that is the
# username). DUDEDILIGENCE_USERNAME is the same field if EMAIL is unset.
# Do not commit real values.
DUDEDILIGENCE_EMAIL=
DUDEDILIGENCE_PASSWORD=

# Optional. Same username field, used only when DUDEDILIGENCE_EMAIL is empty.
DUDEDILIGENCE_USERNAME=

# Optional overrides. If either is set, automatic login is skipped and these
# headers are sent as-is. Leave them empty on Vercel unless you want to bypass
# the email/password login. Do not commit a real cookie or token.
DUDEDILIGENCE_COOKIE=
DUDEDILIGENCE_AUTHORIZATION=

# On Vercel: Project → Settings → Environment Variables. Add
# DUDEDILIGENCE_EMAIL and DUDEDILIGENCE_PASSWORD for Production (and Preview
# if you want the board there). Redeploy after saving. Do not paste secrets
# into the repo, a pull request, or a build log.

# Quotes, headlines, and Bitcoin do not need a key.
# Yahoo Finance (crumb), the timechainstats.com board, and Blockchain.com are public.
#
# Optional. Leave blank and the server reads the public key from the
# timechainstats.com page script. Set this only to skip that lookup.
# Do not commit a real value.
TIMECHAIN_API_KEY=
