# Optional. DudeDiligence's gamma board returns 401 without a signed-in session.
# In the browser, sign in at https://dudediligence.club, then copy the Cookie
# request header from a call to /v1/options/gex/AAPL (DevTools → Network).
# Paste the cookie string here. Do not commit a real value.
DUDEDILIGENCE_COOKIE=

# Optional alternative to the cookie. If the session is a bearer token, set the
# full header value, including the "Bearer " prefix.
DUDEDILIGENCE_AUTHORIZATION=

# On Vercel, set the same names under Project → Settings → Environment Variables
# for Production (and Preview, if you want the board there), then redeploy.
# Do not commit a real cookie or token.

# Quotes, headlines, and Bitcoin do not need a key.
# Yahoo Finance (crumb), the timechainstats.com board, and Blockchain.com are public.
#
# Optional. Leave blank and the server reads the public key from the
# timechainstats.com page script. Set this only to skip that lookup.
# Do not commit a real value.
TIMECHAIN_API_KEY=
